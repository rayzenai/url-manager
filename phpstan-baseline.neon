parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$numberOfFiles of method RayzenAI\\UrlManager\\Commands\\GenerateSitemap\:\:generateSitemapIndex\(\) expects int, float given\.$#'
			identifier: argument.type
			count: 1
			path: src/Commands/GenerateSitemap.php

		-
			message: '#^Cannot access property \$id on class\-string\|object\.$#'
			identifier: property.nonObject
			count: 3
			path: src/Commands/GenerateUrlsForModels.php

		-
			message: '#^Cannot call method isActiveForUrl\(\) on class\-string\|object\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Commands/GenerateUrlsForModels.php

		-
			message: '#^Parameter \#1 \$numberOfFiles of method RayzenAI\\UrlManager\\Commands\\GenerateVideoSitemap\:\:generateVideoSitemapIndex\(\) expects int, float given\.$#'
			identifier: argument.type
			count: 1
			path: src/Commands/GenerateVideoSitemap.php

		-
			message: '#^Method RayzenAI\\UrlManager\\Commands\\MakeModelCommand\:\:handle\(\) should return bool\|null but return statement is missing\.$#'
			identifier: return.missing
			count: 2
			path: src/Commands/MakeModelCommand.php

		-
			message: '#^Access to an undefined property RayzenAI\\UrlManager\\Filament\\Pages\\GoogleSearchConsoleSettings\:\:\$form\.$#'
			identifier: property.notFound
			count: 5
			path: src/Filament/Pages/GoogleSearchConsoleSettings.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Filament/Pages/GoogleSearchConsoleSettings.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 2
			path: src/Http/Controllers/UrlAnalyticsController.php

		-
			message: '#^Call to method Illuminate\\Contracts\\View\\Factory\:\:exists\(\) with ''url\-manager\:\:show'' will always evaluate to false\.$#'
			identifier: method.impossibleType
			count: 1
			path: src/Http/Controllers/UrlController.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 2
			path: src/Http/Controllers/UrlController.php

		-
			message: '#^Cannot call method increment\(\) on class\-string\|object\.$#'
			identifier: method.nonObject
			count: 1
			path: src/Jobs/RecordUrlVisit.php

		-
			message: '#^Offset ''host'' on array\{scheme\?\: string, host\: string, port\?\: int\<0, 65535\>, user\?\: string, pass\?\: string, path\?\: string, query\?\: string, fragment\?\: string\} in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.offset
			count: 1
			path: src/Models/UrlVisit.php

		-
			message: '#^Offset ''meta'' on array\{url_id\: int, ip_address\: string\|null, user_id\: int\|null, referer\: string\|null, meta\: array\<mixed, mixed\>, country_code\?\: non\-falsy\-string, device\: ''mobile'', browser\: non\-falsy\-string, \.\.\.\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Models/UrlVisit.php

		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 1
			path: src/Services/GoogleSearchConsoleService.php

		-
			message: '#^Trait RayzenAI\\UrlManager\\Traits\\HasUrl is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: src/Traits/HasUrl.php

		-
			message: '#^Method RayzenAI\\UrlManager\\UrlManagerPlugin\:\:get\(\) should return static\(RayzenAI\\UrlManager\\UrlManagerPlugin\) but returns Filament\\Contracts\\Plugin\|Filament\\FilamentManager\.$#'
			identifier: return.type
			count: 1
			path: src/UrlManagerPlugin.php

		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 1
			path: src/UrlManagerPlugin.php
